 "grammar": [
  {
   "id": "ja-u01-g01",
   "title": "Dakuten dan handakuten (゛ ゜)",
   "explanation": "Dua garis kecil (゛) di kanan atas mengubah bunyi: か→が (ka→ga), さ→ざ (sa→za), た→だ (ta→da), は→ば (ha→ba). Lingkaran kecil (゜) hanya dipakai di baris は: は→ぱ (ha→pa).",
   "examples": [
    "がっこう",
    "ざっし",
    "てんぷら",
    "ぶどう"
   ],
   "common_mistake": {
    "wrong": "てんふら",
    "right": "てんぷら"
   }
  },
  {
   "id": "ja-u01-g02",
   "title": "Huruf kecil っ dan ゃ ゅ ょ",
   "explanation": "っ kecil menggandakan konsonan berikutnya dan memberi jeda singkat: がっこう (gakkou). ゃ ゅ ょ kecil menyatu dengan huruf sebelumnya menjadi satu suku kata: き + ゃ = きゃ (kya), し + ゅ = しゅ (shu), ち + ょ = ちょ (cho).",
   "examples": [
    "きって",
    "おちゃ",
    "しゅくだい",
    "ちょっと"
   ],
   "common_mistake": {
    "wrong": "おちや",
    "right": "おちゃ"
   }
  },
  {
   "id": "ja-u01-g03",
   "title": "Partikel は, へ, を",
   "explanation": "Tiga huruf ini dibaca berbeda saat menjadi partikel: は dibaca 'wa' (penanda topik), へ dibaca 'e' (arah), dan を dibaca 'o' (penanda objek). Tulisannya tetap は, へ, dan を.",
   "examples": [
    "わたし は がくせい です 。",
    "えき へ いきます 。",
    "ほん を よみます 。"
   ],
   "common_mistake": {
    "wrong": "わたし わ がくせい です 。",
    "right": "わたし は がくせい です 。"
   }
  }
 ],
