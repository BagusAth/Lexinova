 "grammar": [
  {
   "id": "ja-u02-g01",
   "title": "Garis panjang ー",
   "explanation": "Di katakana, vokal panjang ditulis dengan garis ー. コーヒー dibaca koohii (dua ketukan untuk 'oo'). Tanpa garis, kata bisa salah dibaca atau berubah arti.",
   "examples": [
    "コーヒー",
    "ケーキ",
    "ラーメン",
    "スーパー"
   ],
   "common_mistake": {
    "wrong": "コヒー",
    "right": "コーヒー"
   }
  },
  {
   "id": "ja-u02-g02",
   "title": "Kombinasi untuk bunyi asing",
   "explanation": "Untuk bunyi yang tidak ada di bahasa Jepang asli, katakana memakai huruf vokal kecil: ファ (fa), フォ (fo), ティ (ti), ウェ (we), シェ (she). Contoh: パーティー (pesta), フォーク (garpu).",
   "examples": [
    "パーティー",
    "フォーク",
    "シェフ",
    "ウェブ"
   ],
   "common_mistake": {
    "wrong": "フオーク",
    "right": "フォーク"
   }
  },
  {
   "id": "ja-u02-g03",
   "title": "Nama dan negara ditulis katakana",
   "explanation": "Nama orang asing dan nama negara ditulis dengan katakana. Nama Bagus menjadi バグス, Indonesia menjadi インドネシア, Jakarta menjadi ジャカルタ.",
   "examples": [
    "バグス",
    "インドネシア",
    "ジャカルタ",
    "バリ"
   ],
   "common_mistake": {
    "wrong": "ばぐす",
    "right": "バグス"
   }
  }
 ],
